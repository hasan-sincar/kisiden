rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == 'hasanmardinn@gmail.com'
      );
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isFutureTimestamp(fieldName) {
      return isSignedIn()
        && currentUserDocExists()
        && currentUserDoc().data.keys().hasAny([fieldName])
        && currentUserDoc().data[fieldName] is timestamp
        && currentUserDoc().data[fieldName] > request.time;
    }

    function isChatMuted() {
      return isFutureTimestamp('chatMutedUntil');
    }

    function isChatStartBlocked() {
      return isFutureTimestamp('chatNewThreadBlockedUntil');
    }

    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(allowedKeys);
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatExists(chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatIdContainsUid(chatId) {
      return chatId.matches('(^|_)' + request.auth.uid + '(_|$)');
    }

    function isChatParticipant(chatId) {
      return isSignedIn() && (
        (chatExists(chatId)
          && chatDoc(chatId).data.participants is list
          && request.auth.uid in chatDoc(chatId).data.participants)
        || chatIdContainsUid(chatId)
      );
    }
    
    // KULLANICILAR: Sadece giriş yapmış olanlar kendi profilini düzenleyebilir
    match /users/{userId} {
      // GÜVENLİK İYİLEŞTİRMESİ: Kullanıcı verilerini (profil detayları gibi) sadece giriş yapmış diğer kullanıcılar okuyabilir.
      allow read: if isSignedIn(); 
      allow create, delete: if isOwner(userId) || isAdmin();

      // GÜVENLİK İYİLEŞTİRMESİ: Kullanıcıların sadece belirli alanları güncelleyebilmesini sağlar.
      // Bu kural, kullanıcıların kendi kendilerine Pro üyelik veya ilan hakkı gibi kritik verileri atamasını engeller.
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          // Kullanıcının kendisinin değiştirebileceği güvenli alanlar
          'name', 'lastNameChangeAt', 'photoUrl', 'coverPhotoUrl', 'aboutMe', 'contactPreference',
          'instagram', 'facebook', 'website', 'fcmToken', 'emailNotifications',
          'emailNotificationsEnabled', 'blockedUsers', 'languageCode',
          'phoneNumber', 'email', 'profileSetupSkipped',
          'profileSetupSkippedAt', 'customReadyMessages', 'updatedAt'
      ]));
    }

    match /users/{userId}/favorites/{listingId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/blocked/{blockedUid} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/followers/{followerId} {
      allow read: if isSignedIn() || isAdmin();
      allow create, delete: if (isSignedIn() && request.auth.uid == followerId) || isAdmin();
      allow update: if false;
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasOnly([
          'title', 'message', 'isRead', 'timestamp', 'type', 'targetId', 'reason', 'source', 'imageUrl'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.isRead == false
        && request.resource.data.timestamp == request.time
        && (!('type' in request.resource.data) || request.resource.data.type is string)
        && (!('targetId' in request.resource.data) || request.resource.data.targetId is string)
        && (!('reason' in request.resource.data) || request.resource.data.reason is string)
        && (!('source' in request.resource.data) || request.resource.data.source is string)
        && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string);
    }

    match /users/{userId}/review_permissions/{reviewerId} {
      allow read: if isOwner(userId) || (isSignedIn() && request.auth.uid == reviewerId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || (isSignedIn() && request.auth.uid == reviewerId) || isAdmin();
      allow update: if false;
    }

    match /users/{userId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // İLANLAR: Herkes okuyabilir, ama sadece giriş yapanlar ilan ekleyebilir.
    // Sadece ilanın sahibi VEYA admin ilanı silebilir/düzenleyebilir.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /listings/{listingId}/questions/{questionId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid
        || isAdmin()
      );
    }
    
    // MESAJLAR (SOHBET): Sadece sohbetteki katılımcılar mesajları okuyup yazabilir.
    match /chats/{chatId} {
      allow create: if isSignedIn()
        && !isChatStartBlocked()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && chatId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'lastMessage', 'lastMessageTime', 'unreadBy',
          'listingTitle', 'listingId', 'listingImage', 'listingPrice',
          'offerStatus'
        ]);

      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatParticipant(chatId);

      allow create: if isChatParticipant(chatId)
        && !isChatMuted()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && (!('type' in request.resource.data)
          || request.resource.data.type is string)
        && (!('meetingPoint' in request.resource.data)
          || request.resource.data.meetingPoint is map);

      allow update: if isChatParticipant(chatId)
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.timestamp == resource.data.timestamp
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'offerStatus', 'message', 'editedAt'
        ]);

      allow delete: if isChatParticipant(chatId)
        && (resource.data.senderId == request.auth.uid || isAdmin());
    }

    // KATEGORİLER VE SİSTEM AYARLARI: Okunabilir ama dışarıdan ASLA değiştirilemez!
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AYARLAR (İstatistikler, Reklamlar vb.)
    match /settings/{document=**} {
      allow read: if true; // Herkes ayarları ve istatistikleri okuyabilir
      allow write: if isAdmin();
    }

    // ŞİKAYETLER VE RAPORLAR
    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if false;
    }

    // TAKAS TEKLİFLERİ
    match /trade_offers/{offerId} {
      allow read: if isSignedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
          || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId is string;

      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.receiverId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.senderListingId == resource.data.senderListingId
          && request.resource.data.receiverListingId == resource.data.receiverListingId
          && request.resource.data.status in ['accepted', 'rejected']
          && onlyChanges(['status', 'updatedAt']));

      allow delete: if isAdmin();
    }
    
    // SATIN ALMALAR (Pro paket, vitrin vb.)
    match /purchases/{purchaseId} {
      allow get: if isSignedIn() || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.packageId in [
          'pro_3_ay', 'pro_6_ay', 'pro_12_ay',
          'vitrin_1_gun', 'vitrin_1_hafta', 'vitrin_1_ay',
          'kat_vitrin_1_gun', 'kat_vitrin_1_hafta', 'kat_vitrin_1_ay',
          'acil_2_gun', 'acil_3_gun', 'acil_7_gun'
        ]
      );
      allow update, delete: if isAdmin();
    }

    match /search_alarms/{alarmId} {
      allow read, create, update, delete: if isAdmin()
        || (isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || request.resource.data.userId == request.auth.uid
          ));
    }

    match /mailCodes/{codeId} {
      allow create: if isSignedIn()
        && request.resource.data.email is string
        && request.resource.data.email.size() > 4
        && request.resource.data.email.size() <= 254
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4
        && request.resource.data.code.size() <= 12
        && request.resource.data.keys().hasOnly(['email', 'code', 'createdAt'])
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
      allow read, update, delete: if isAdmin();
    }
    
    // DESTEK TALEPLERİ VE MESAJLARI
    match /tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /tickets/{ticketId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
        || isAdmin()
      );
      allow create: if isSignedIn()
        && (
          (request.resource.data.senderId == request.auth.uid
            && get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid)
          || isAdmin()
        );
      allow update, delete: if isAdmin();
    }

    // Diğer bilinmeyen tüm koleksiyonları kitle (Sızıntıları engeller)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
